#!/usr/bin/env bash
# Sanitize Qt platform environment
export QT_QPA_PLATFORM=xcb
export QT_QPA_PLATFORMTHEME=generic
export QT_STYLE_OVERRIDE=Fusion
unset QT_PLUGIN_PATH

# Locate DuckStation inside ~/appimages
APPIMAGE=$(find "$HOME/appimages" -maxdepth 1 -iname "*duckstation*.AppImage" 2>/dev/null | head -n 1)

if [ -z "$APPIMAGE" ]; then
    echo "❌ Error: No DuckStation AppImage found in $HOME/appimages/"
    exit 1
fi

exec "$APPIMAGE" -fullscreen "$@"
