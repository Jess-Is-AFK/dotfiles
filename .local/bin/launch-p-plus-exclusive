#!/usr/bin/env bash
set -e

CRT="VGA-1"

# 1. Set CRT output to 480i and focus workspace
swaymsg "output ${CRT} enable mode 2560x480" 2>/dev/null || true
swaymsg "focus output ${CRT}" 2>/dev/null || true

# 2. Always restore 240p upon exiting the emulator
trap 'swaymsg "output '${CRT}' mode 2560x240" 2>/dev/null || true' EXIT INT TERM

# 3. Launch Flatpak natively (Direct Wayland/X11 on Sway)
flatpak run org.projectplusgame.project-plus-dolphin "$@"
