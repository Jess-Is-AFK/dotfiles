#!/usr/bin/env bash
# ~/.local/bin/launch-p-plus-exclusive
set -e

CRT_CONNECTOR="VGA-1"
MODE="480i"
REFRESH=60
VIRTUAL_W=640
VIRTUAL_H=480

# Parse optional resolution override (-r 480i or -r 240p)
while [[ $# -gt 0 ]]; do
    case "$1" in
        -r|--resolution)
            MODE="$2"
            shift 2
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
    esac
done

case "$MODE" in
    480i)
        OUT_W=2560
        OUT_H=480
        ;;
    240p)
        OUT_W=2560
        OUT_H=240
        ;;
    *)
        echo "❌ Unknown mode '$MODE'. Use '480i' (native Wii) or '240p' (scanlines)."
        exit 1
        ;;
esac

# Locate Project+ AppImage, standalone script, or default system dolphin-emu
PPLUS_BIN="$1"
if [[ -z "$PPLUS_BIN" ]]; then
    if [[ -x "$HOME/appimages/Project-Plus/Project-Plus-Dolphin.AppImage" ]]; then
        PPLUS_BIN="$HOME/appimages/Project-Plus/Project-Plus-Dolphin.AppImage"
    elif [[ -x "$HOME/Games/Project+/Project-Plus.AppImage" ]]; then
        PPLUS_BIN="$HOME/Games/Project+/Project-Plus.AppImage"
    elif [[ -x "$HOME/appimages/Project+/Project-Plus.AppImage" ]]; then
        PPLUS_BIN="$HOME/appimages/Project+/Project-Plus.AppImage"
    elif command -v dolphin-emu &>/dev/null; then
        PPLUS_BIN="$(command -v dolphin-emu)"
    else
        PPLUS_BIN=$(find "$HOME" -maxdepth 4 -type f -name "*Project*Plus*.AppImage" -perm -111 2>/dev/null | head -n1 || true)
    fi
fi

if [[ -z "$PPLUS_BIN" ]]; then
    echo "Usage: launch-p-plus-exclusive [-r 480i|240p] [/path/to/Project-Plus.AppImage or dolphin-emu]"
    echo "Error: Project+ executable or dolphin-emu not found."
    exit 1
fi

shift $(( $# > 0 ? 1 : 0 )) 2>/dev/null || true
EXTRA_ARGS=("$@")

# Toolkit & display environment hygiene
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
export ENABLE_GAMESCOPE_WSI=0
unset VK_ICD_FILENAMES

# Force X11/XCB backends so Dolphin's Qt interface maps cleanly into Gamescope
export QT_QPA_PLATFORM=xcb
export QT_QPA_PLATFORMTHEME=generic
export SDL_VIDEODRIVER=x11

# Always restore clean 240p desktop state upon exit
trap 'swaymsg "output '${CRT_CONNECTOR}' mode 2560x240" 2>/dev/null || true' EXIT INT TERM

# Modeset VGA-1 in Sway and move focus
swaymsg "output ${CRT_CONNECTOR} enable mode ${OUT_W}x${OUT_H}" 2>/dev/null || true
swaymsg "focus output ${CRT_CONNECTOR}" 2>/dev/null || true

echo "🥊 Launching Project+ on ${CRT_CONNECTOR} (${MODE}: 640x480 -> ${OUT_W}x${OUT_H})..."

exec gamescope \
  -w "$VIRTUAL_W" -h "$VIRTUAL_H" \
  -W "$OUT_W" -H "$OUT_H" \
  --scaler stretch \
  --filter nearest \
  -r "$REFRESH" \
  --force-grab-cursor \
  -f \
  -- "$PPLUS_BIN" "${EXTRA_ARGS[@]}"
