#!/usr/bin/env bash
set -e

MODE="240p"
CRT_CONNECTOR="VGA-1"
SOH_BIN=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -r|--resolution)
            MODE="$2"
            shift 2
            ;;
        -b|--binary)
            SOH_BIN="$2"
            shift 2
            ;;
        *)
            if [ -z "$SOH_BIN" ] && [ -f "$1" ]; then
                SOH_BIN="$1"
                shift
            else
                echo "❌ Unknown argument: $1"
                exit 1
            fi
            ;;
    esac
done

# Auto-detect binary if not explicitly provided
if [ -z "$SOH_BIN" ]; then
    POSSIBLE_PATHS=(
        "$HOME/Games/soh/soh.elf"
        "$HOME/Games/soh/soh.appimage"
        "$HOME/.local/share/soh/soh.elf"
        "/usr/bin/soh.elf"
        "/usr/bin/soh"
	"$HOME/appimages/SoH/soh.appimage"
    )
    for path in "${POSSIBLE_PATHS[@]}"; do
        if [ -f "$path" ]; then
            SOH_BIN="$path"
            break
        fi
    done
fi

if [ -z "$SOH_BIN" ] || [ ! -f "$SOH_BIN" ]; then
    echo "Usage: launch-soh-exclusive [-r 240p|480i] [/path/to/soh.elf]"
    exit 1
fi

chmod +x "$SOH_BIN" 2>/dev/null || true

# Revert Sway CRT output to baseline 2560x240 on exit
trap 'swaymsg "output '${CRT_CONNECTOR}' mode 2560x240" 2>/dev/null || true; swaymsg "focus output '${CRT_CONNECTOR}'" 2>/dev/null || true' EXIT INT TERM

case "$MODE" in
    240p)
        OUT_W=2560; OUT_H=240; REFRESH=60
        swaymsg "output ${CRT_CONNECTOR} mode 2560x240"
        ;;
    480i)
        OUT_W=2560; OUT_H=480; REFRESH=60
        swaymsg "output ${CRT_CONNECTOR} mode 2560x480"
        ;;
    *)
        echo "❌ Unknown mode '$MODE'. Supported: 240p, 480i"
        exit 1
        ;;
esac

swaymsg "focus output ${CRT_CONNECTOR}"

echo "🗡️ Launching Ship of Harkinian ($MODE) stretched across ${OUT_W}x${OUT_H} on ${CRT_CONNECTOR}..."

# 1. -w 640 -h 480: Presents a standard 4:3 canvas to SoH and ImGui.
# 2. -W $OUT_W -H $OUT_H -S stretch: Fills the 2560 horizontal line so the CRT compresses it to 4:3.
# 3. SDL_VIDEODRIVER=x11: Sandboxes SDL within Xwayland so it cannot poll Sway's mode table.
# 4. --force-grab-cursor: Traps mouse/cursor focus inside the game window.
exec gamescope \
  -w 640 -h 480 \
  -W "$OUT_W" -H "$OUT_H" \
  -S stretch \
  -F nearest \
  -r "$REFRESH" \
  --force-grab-cursor \
  -f \
  -- env SDL_VIDEODRIVER=x11 "$SOH_BIN"
