#!/usr/bin/env bash
set -e

CRT_CONNECTOR="VGA-1"
OUT_W=2560
OUT_H=240
REFRESH=60
VIRTUAL_W=640
VIRTUAL_H=480

SOH_APPIMAGE="${1:-$HOME/appimages/SoH/soh.appimage}"

if [[ ! -f "$SOH_APPIMAGE" ]]; then
    echo "Error: SoH AppImage not found at '$SOH_APPIMAGE'"
    exit 1
fi

chmod +x "$SOH_APPIMAGE" 2>/dev/null || true
SOH_DIR="$(dirname "$SOH_APPIMAGE")"

# Runtime environment
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
export ENABLE_GAMESCOPE_WSI=0
unset VK_ICD_FILENAMES

# Constrain SDL2 to X11 inside Gamescope
export SDL_VIDEODRIVER=x11

# Always restore clean 240p desktop state upon exit
trap 'swaymsg "output '${CRT_CONNECTOR}' mode 2560x240" 2>/dev/null || true' EXIT INT TERM

# Ensure VGA-1 is set to 2560x240 and focused
swaymsg "output ${CRT_CONNECTOR} enable mode 2560x240" 2>/dev/null || true
swaymsg "focus output ${CRT_CONNECTOR}" 2>/dev/null || true

echo "🗡️ Launching Ship of Harkinian on ${CRT_CONNECTOR} (Stretching 640x480 -> 2560x240)..."

cd "$SOH_DIR"
exec gamescope \
  -w "$VIRTUAL_W" -h "$VIRTUAL_H" \
  -W "$OUT_W" -H "$OUT_H" \
  --scaler stretch \
  --filter nearest \
  -r "$REFRESH" \
  --force-grab-cursor \
  -f \
  -- "$SOH_APPIMAGE"
